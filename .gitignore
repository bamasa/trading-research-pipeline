# --- OS / editors -----------------------------------------------------------
.DS_Store
.idea/
.vscode/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# --- Data, artifacts, runs --------------------------------------------------
# Nothing that lands in these directories belongs in version control.
#
# The leading slash anchors each pattern to the repository root, and it is not
# optional: an unanchored `data/` also matches `src/trading_research/data/`, which would
# silently exclude package source from every commit.
/data/
/artifacts/
/models/
/runs/
/reports/

# Run logs. Tracebacks in these embed absolute local paths, which is how one
# reached a commit before the audit was widened to read every file.
/logs/
*.log

# --- Binary / heavy formats -------------------------------------------------
# Belt and braces: even outside the directories above, these never get committed.
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.onnx
*.pth
*.pt
*.ckpt
*.npy
*.npz

# --- Secrets ----------------------------------------------------------------
.env
.env.*
*.env
secrets.yaml
credentials.json

# Intermediate per-trade tables. The summaries in experiments/results are small
# and are what the documents cite; the raw trade lists behind them run to tens of
# megabytes, are regenerable by re-running the script, and belong nowhere near
# version control. One reached a commit before this rule existed.
/experiments/results/*_trades.csv

# --- Exceptions -------------------------------------------------------------
# A tiny committed sample is allowed so that the docs can show real output
# without anyone having to download or generate anything first.
!tests/fixtures/**
